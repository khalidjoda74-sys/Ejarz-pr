rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isActiveAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.status == 'active';
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validImage(2 * 1024 * 1024);
      allow delete: if isOwner(uid) || isActiveAdmin();
    }

    match /sponsors/{sponsorId}/logo/{fileName} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin() && validImage(3 * 1024 * 1024);
    }

    match /categories/{categoryId}/icon/{fileName} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin() && validImage(2 * 1024 * 1024);
    }

    match /councils/{councilId}/cover/{fileName} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin() && validImage(5 * 1024 * 1024);
    }

    match /councils/{councilId}/images/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validImage(5 * 1024 * 1024);
      allow delete: if isOwner(uid) || isActiveAdmin();
    }
    match /conversations/{conversationId}/images/{uid}/{fileName} {
      allow read: if isActiveAdmin()
        || (
          isSignedIn()
          && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
          && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid])
        );
      allow create, update: if isOwner(uid)
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid])
        && validImage(5 * 1024 * 1024);
      allow delete: if isOwner(uid) || isActiveAdmin();
    }

    match /companyPolls/{pollId}/logo/{fileName} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin() && validImage(3 * 1024 * 1024);
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isActiveAdmin() && validImage(5 * 1024 * 1024);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
